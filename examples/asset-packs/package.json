{
  "name": "@mpgd/example-asset-packs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode bundled",
    "dev:hybrid": "vite --mode hybrid",
    "build": "ttsc --noEmit && vite build --mode bundled && vite build --mode hybrid && node test/artifacts.mjs",
    "check": "ttsc --noEmit",
    "test:browser": "node test/browser.mjs",
    "test:packed-consumer": "node test/packed-consumer.mjs",
    "serve:assets": "node test/static-server.mjs artifacts/origin 5196",
    "build:delivery": "node ../../tools/run-ttsx.mjs --project tsconfig.delivery-build.json test/build-delivery.ts"
  },
  "dependencies": {
    "@mpgd/phaser-assets": "workspace:*",
    "phaser": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "1.62.1",
    "ttsc": "0.30.4",
    "typescript": "7.0.2",
    "vite": "^8.1.3"
  }
}
