{
  "name": "@mpgd/phaser-assets",
  "bugs": {
    "url": "https://github.com/imjlk/mpgd-kit/issues"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "description": "Target-portable Phaser asset manifest and loader helpers for mpgd games.",
  "devDependencies": {
    "phaser": "4.2.0",
    "ttsc": "0.18.4",
    "typescript": "7.0.2",
    "vitest": "^4.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./archive-worker": {
      "types": "./dist/archive-worker.d.ts",
      "default": "./dist/archive-worker.js"
    },
    "./archives": {
      "types": "./dist/archives.d.ts",
      "default": "./dist/archives.js"
    },
    "./archive-validation": {
      "types": "./dist/archive-validation.d.ts",
      "default": "./dist/archive-validation.js"
    },
    "./delivery": {
      "types": "./dist/delivery.d.ts",
      "default": "./dist/delivery.js"
    },
    "./pack-format": {
      "types": "./dist/pack-format.d.ts",
      "default": "./dist/pack-format.js"
    },
    "./packs": {
      "types": "./dist/packs.d.ts",
      "default": "./dist/packs.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils.d.ts",
      "default": "./dist/test-utils.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/imjlk/mpgd-kit#readme",
  "keywords": [
    "mpgd",
    "phaser",
    "assets",
    "vite",
    "apps-in-toss",
    "capacitor",
    "devvit"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "peerDependencies": {
    "phaser": ">=4.0.0 <5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjlk/mpgd-kit.git",
    "directory": "packages/phaser-assets"
  },
  "scripts": {
    "check": "ttsc --noEmit",
    "lint": "ttsc --noEmit",
    "test": "vitest run",
    "format": "ttsc format",
    "fix": "ttsc fix"
  },
  "sideEffects": [
    "./dist/archive-worker.js",
    "./src/archive-worker.ts"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.6.0"
}
