{
  "name": "@mpgd/target-config",
  "version": "0.21.0",
  "description": "Target-specific platform feature availability and effective config helpers for mpgd.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjlk/mpgd-kit.git",
    "directory": "packages/target-config"
  },
  "bugs": {
    "url": "https://github.com/imjlk/mpgd-kit/issues"
  },
  "homepage": "https://github.com/imjlk/mpgd-kit#readme",
  "keywords": [
    "mpgd",
    "phaser",
    "vite",
    "typescript",
    "capacitor",
    "apps-in-toss",
    "game-development",
    "game-distribution"
  ],
  "type": "module",
  "sideEffects": [
    "./adaptive-shell.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./targets.json": "./targets.json",
    "./asset-packs": {
      "types": "./dist/asset-packs.d.ts",
      "default": "./dist/asset-packs.js"
    },
    "./adaptive-shell": {
      "types": "./dist/adaptive-shell/index.d.ts",
      "default": "./dist/adaptive-shell/index.js"
    },
    "./adaptive-shell/base.css": "./adaptive-shell.css"
  },
  "files": [
    "dist",
    "targets.json",
    "adaptive-shell.css"
  ],
  "scripts": {
    "check": "ttsc --noEmit",
    "lint": "ttsc --noEmit",
    "format": "ttsc format",
    "fix": "ttsc fix",
    "test": "pnpm build && vitest run test/adaptive-shell.test.ts && node test/adaptive-shell-dist-import.mjs && cd ../.. && node tools/run-ttsx.mjs packages/target-config/test/target-config-smoke.ts && node tools/run-ttsx.mjs packages/target-config/test/platform-version-allocation-smoke.ts && node tools/run-ttsx.mjs packages/target-config/test/provider-availability-smoke.ts",
    "build": "cd ../.. && node tools/run-ttsx.mjs tools/package/build-packages.ts @mpgd/target-config"
  },
  "dependencies": {
    "@mpgd/catalog": "workspace:*",
    "@mpgd/i18n": "workspace:*",
    "@mpgd/platform": "workspace:*",
    "typia": "13.0.2"
  },
  "devDependencies": {
    "ttsc": "0.30.4",
    "typescript": "7.0.2",
    "jsdom": "24.1.0",
    "vitest": "^4.0.0",
    "@types/node": "24.13.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
