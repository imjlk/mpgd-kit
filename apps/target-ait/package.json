{
  "name": "@mpgd/target-ait",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "MPGD_AIT_LOCAL_MOCK=1 VITE_MPGD_AIT_MOCK_IDENTITY=1 vite --host 0.0.0.0",
    "dev:plain": "pnpm dev",
    "build": "vite build && ait build",
    "ait:build": "ait build",
    "ait:deploy": "ait deploy --api-key \"$AIT_API_KEY\"",
    "test": "pnpm --dir ../../adapters/ait test",
    "check": "ttsc --noEmit",
    "lint": "ttsc --noEmit",
    "format": "ttsc format",
    "fix": "ttsc fix"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.0.2",
    "@mpgd/adapter-ait": "workspace:*"
  },
  "devDependencies": {
    "@apps-in-toss/cli": "3.0.2",
    "@ttsc/unplugin": "0.18.4",
    "@types/node": "^24.0.0",
    "ttsc": "0.18.4",
    "typescript": "7.0.2",
    "vite": "^8.1.3"
  }
}
