{
  "name": "@mpgd/adapter-ait",
  "version": "0.20.4",
  "description": "Apps in Toss WebView platform adapter for mpgd games.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjlk/mpgd-kit.git",
    "directory": "adapters/ait"
  },
  "bugs": {
    "url": "https://github.com/imjlk/mpgd-kit/issues"
  },
  "homepage": "https://github.com/imjlk/mpgd-kit#readme",
  "keywords": [
    "mpgd",
    "phaser",
    "vite",
    "typescript",
    "capacitor",
    "apps-in-toss",
    "game-development",
    "game-distribution"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./wrapper": {
      "types": "./dist/wrapper.d.ts",
      "default": "./dist/wrapper.js"
    },
    "./ad-config": {
      "types": "./dist/ad-config.d.ts",
      "default": "./dist/ad-config.js"
    },
    "./iap-config": {
      "types": "./dist/iap-config.d.ts",
      "default": "./dist/iap-config.js"
    },
    "./notification-config": {
      "types": "./dist/notification-config.d.ts",
      "default": "./dist/notification-config.js"
    },
    "./local-mock": {
      "types": "./dist/local-mock.d.ts",
      "default": "./dist/local-mock.js"
    },
    "./safe-area": {
      "types": "./dist/safe-area.d.ts",
      "default": "./dist/safe-area.js"
    },
    "./authority-fetch": {
      "types": "./dist/authority-fetch.d.ts",
      "default": "./dist/authority-fetch.js"
    },
    "./origins": {
      "types": "./dist/origins.d.ts",
      "default": "./dist/origins.js"
    },
    "./package.json": "./package.json",
    "./anonymous-auth": {
      "types": "./dist/anonymous-auth.d.ts",
      "default": "./dist/anonymous-auth.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "ttsc --noEmit",
    "lint": "ttsc --noEmit",
    "format": "ttsc format",
    "fix": "ttsc fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@ait-kit/sdk": "0.7.0",
    "@mpgd/bridge": "workspace:*",
    "@mpgd/catalog": "workspace:*",
    "@mpgd/platform": "workspace:*"
  },
  "peerDependencies": {
    "@apps-in-toss/web-framework": ">=3.0.0 <4"
  },
  "peerDependenciesMeta": {
    "@apps-in-toss/web-framework": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apps-in-toss/web-framework": "3.6.0",
    "@mpgd/game-runtime": "workspace:*",
    "@types/node": "^24.0.0",
    "ttsc": "0.32.1",
    "typescript": "7.0.2",
    "vitest": "^4.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
