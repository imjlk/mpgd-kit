// Copied as types.ts into a tarball-installed consumer after packages are built.
import {
  createCapacitorNativeJsonTransport,
  createCommerceServiceProvider,
  createStoreCommerceProvider,
  normalizeStoreSdkError,
  type CapacitorCommerceServiceProvider,
  type CapacitorNativeJsonTransport,
  type CapacitorServiceProvider,
  type CapacitorViewportBaseState,
  type CapacitorViewportController,
  type StoreCommerceProvider,
  type StoreSdk,
  type StoreSdkErrorCodeMap,
  type StoreSdkEvent,
} from '@mpgd/adapter-capacitor';
import type { CommerceError, CommerceProvider } from '@mpgd/platform/commerce';
import {
  createCapacitorAdMobRewardedProvider,
  type CapacitorAdMobRewardedProvider,
} from '@mpgd/adapter-capacitor/admob';
// @ts-expect-error The deprecated App Store verifier subpath is removed.
import type * as removedAppStoreServer from '@mpgd/adapter-capacitor/app-store-server';
import type {
  CommerceCapabilities,
  PlatformProviderAvailability,
  PlatformProviderFeature,
  PlatformViewportState,
  SecureCredentialStore,
} from '@mpgd/platform';
import type { FeatureAvailabilityReason, PlatformFeature } from '@mpgd/target-config';

const feature: PlatformProviderFeature = 'pushNotifications';
const readiness: PlatformProviderAvailability = 'configuration-required';
const targetFeature: PlatformFeature = 'subscriptions';
const reason: FeatureAvailabilityReason = 'temporarily-unavailable';
const provider: CapacitorServiceProvider = {
  id: 'packed-store',
  features: [feature],
  methods: ['notifications.getStatus', 'notifications.requestSubscription'],
  bridge: {
    async request(input) {
      return {
        id: input.id,
        ok: false,
        error: {
          code: 'NOT_CONFIGURED',
          message: 'Unavailable.',
          retryable: false,
        },
      };
    },
  },
  async getAvailability() {
    return { [feature]: readiness };
  },
};

void provider;
void targetFeature;
void reason;
const admob: CapacitorAdMobRewardedProvider = createCapacitorAdMobRewardedProvider({
  adUnits: { CONTINUE: 'ca-app-pub-1234567890123456/1234567890' },
  getPlayerId: () => 'player-1',
});
void admob;

const nativeJson: CapacitorNativeJsonTransport = createCapacitorNativeJsonTransport({
  target: 'ios',
  baseUrl: 'https://api.example.com',
  allowedOrigin: 'https://api.example.com',
});
void nativeJson;

declare const viewport: CapacitorViewportController;
const viewportState: PlatformViewportState = viewport.getState();
void viewportState;
declare const hostState: CapacitorViewportBaseState;
void hostState;

declare const packedGateway: import('@mpgd/platform').PlatformGateway;
const secureCredentials: SecureCredentialStore | undefined = packedGateway.secureCredentials;
void secureCredentials;
const commerce: CommerceProvider | undefined = packedGateway.commerce;
void commerce;
export async function readCommerceBlock(): Promise<CommerceCapabilities> {
  return (await packedGateway.getCapabilities()).commerce;
}

declare const storeSdk: StoreSdk;
const storeEvent: StoreSdkEvent = { type: 'purchaseError', error: { code: 'E_X' } };
void storeEvent;
const mapError: StoreSdkErrorCodeMap = { E_X: 'NETWORK' };
const storeProvider: StoreCommerceProvider = createStoreCommerceProvider({
  sdk: storeSdk,
  products: [{ logicalId: 'gems_small', storeSku: 'gems.small', kind: 'consumable' }],
  evidenceSchema: 'packed.store.v1',
  authority: { evidence: 'client-token', accountBinding: 'optional' },
  mapError,
});
const storeService: CapacitorCommerceServiceProvider = createCommerceServiceProvider({
  id: 'packed-store',
  commerce: storeProvider,
});
const storeServiceAsProvider: CapacitorServiceProvider = storeService;
void storeServiceAsProvider;
const normalized: CommerceError = normalizeStoreSdkError({ code: 'E_X' }, mapError);
void normalized;
