{
  "name": "@mpgd/adapter-capacitor",
  "version": "0.16.2",
  "description": "Capacitor platform adapter for mpgd Android and iOS shells.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjlk/mpgd-kit.git",
    "directory": "adapters/capacitor"
  },
  "bugs": {
    "url": "https://github.com/imjlk/mpgd-kit/issues"
  },
  "homepage": "https://github.com/imjlk/mpgd-kit#readme",
  "keywords": [
    "mpgd",
    "phaser",
    "vite",
    "typescript",
    "capacitor",
    "apps-in-toss",
    "game-development",
    "game-distribution"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admob": {
      "types": "./dist/admob.d.ts",
      "default": "./dist/admob.js"
    },
    "./crash-reporting": {
      "types": "./dist/crash-reporting.d.ts",
      "default": "./dist/crash-reporting.js"
    },
    "./notifications": {
      "types": "./dist/notifications.d.ts",
      "default": "./dist/notifications.js"
    },
    "./reviews": {
      "types": "./dist/reviews.d.ts",
      "default": "./dist/reviews.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "ttsc --noEmit",
    "lint": "ttsc --noEmit",
    "format": "ttsc format",
    "fix": "ttsc fix",
    "test:native-http-runtime": "node test/native-http-runtime.mjs",
    "test": "vitest run && node test/package-import.mjs && node test/native-http-runtime.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@mpgd/bridge": "workspace:*",
    "@mpgd/capacitor-game-services": "workspace:*",
    "@mpgd/game-services": "workspace:*",
    "@mpgd/platform": "workspace:*",
    "@mpgd/target-config": "workspace:*"
  },
  "peerDependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-firebase/crashlytics": "^8.5.2",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/core": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capawesome/capacitor-app-review": "^8.1.0"
  },
  "peerDependenciesMeta": {
    "@capacitor-community/admob": {
      "optional": true
    },
    "@capacitor-firebase/crashlytics": {
      "optional": true
    },
    "@capacitor-firebase/messaging": {
      "optional": true
    },
    "@capacitor/local-notifications": {
      "optional": true
    },
    "@capawesome/capacitor-app-review": {
      "optional": true
    }
  },
  "devDependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor-firebase/crashlytics": "8.5.2",
    "@capacitor-firebase/messaging": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capawesome/capacitor-app-review": "8.1.0",
    "@mpgd/game-runtime": "workspace:*",
    "ttsc": "0.32.1",
    "typescript": "7.0.2",
    "vitest": "^4.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
