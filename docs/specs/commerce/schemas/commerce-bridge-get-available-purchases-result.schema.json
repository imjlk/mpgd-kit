{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/imjlk/mpgd-kit/docs/specs/commerce/schemas/commerce-bridge-get-available-purchases-result.schema.json",
  "title": "CommerceBridgeGetAvailablePurchasesResult",
  "x-mpgd-protocol": "mpgd.commerce.v2",
  "x-mpgd-protocol-version": "2.0.0-draft.1",
  "$ref": "#/components/schemas/CommerceBridgeGetAvailablePurchasesResult",
  "components": {
    "schemas": {
      "CommerceBridgeGetAvailablePurchasesResult": {
        "type": "object",
        "properties": {
          "purchases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StorePurchase"
            },
            "readOnly": true
          }
        },
        "required": [
          "purchases"
        ],
        "additionalProperties": false
      },
      "CommerceLogicalProductId": {
        "type": "string",
        "minLength": 1,
        "description": "`LogicalProductId` narrowed to its open string branch and tagged non-empty,\nso validators and the generated schemas carry `minLength: 1`. Starter ids and\nplain `LogicalProductId` values remain assignable."
      },
      "IsoTimestamp": {
        "type": "string",
        "format": "date-time"
      },
      "NonEmptyString": {
        "type": "string",
        "minLength": 1
      },
      "PlatformEvidenceEnvelope": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "readOnly": true
          },
          "payload": {
            "$ref": "#/components/schemas/ReadonlyRecordstringstringnumberboolean",
            "readOnly": true
          }
        },
        "required": [
          "schema",
          "payload"
        ],
        "additionalProperties": false
      },
      "PositiveQuantity": {
        "type": "integer",
        "minimum": 1
      },
      "ReadonlyRecordstringstringnumberboolean": {
        "type": "object",
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "StorePurchase": {
        "type": "object",
        "properties": {
          "store": {
            "$ref": "#/components/schemas/NonEmptyString",
            "readOnly": true
          },
          "transactionId": {
            "$ref": "#/components/schemas/NonEmptyString",
            "description": "Store transaction id; a provider derives one when the store has none.",
            "readOnly": true
          },
          "originalTransactionId": {
            "$ref": "#/components/schemas/NonEmptyString",
            "readOnly": true
          },
          "storeSku": {
            "$ref": "#/components/schemas/NonEmptyString",
            "readOnly": true
          },
          "logicalId": {
            "$ref": "#/components/schemas/CommerceLogicalProductId",
            "readOnly": true
          },
          "quantity": {
            "$ref": "#/components/schemas/PositiveQuantity",
            "readOnly": true
          },
          "state": {
            "$ref": "#/components/schemas/StorePurchaseState",
            "readOnly": true
          },
          "purchasedAt": {
            "$ref": "#/components/schemas/IsoTimestamp",
            "readOnly": true
          },
          "token": {
            "$ref": "#/components/schemas/NonEmptyString",
            "description": "Play purchase token, App Store signed transaction (JWS), or host order id.",
            "readOnly": true
          },
          "evidence": {
            "$ref": "#/components/schemas/PlatformEvidenceEnvelope",
            "readOnly": true
          },
          "accountBinding": {
            "$ref": "#/components/schemas/StorePurchaseAccountBinding",
            "readOnly": true
          },
          "settlement": {
            "type": "object",
            "properties": {
              "ledgerEntryId": {
                "$ref": "#/components/schemas/NonEmptyString",
                "readOnly": true
              }
            },
            "required": [
              "ledgerEntryId"
            ],
            "additionalProperties": false,
            "description": "Present only for `authority.evidence: 'adapter-settled'`; a reconciler pointer, not a grant.",
            "readOnly": true
          }
        },
        "required": [
          "store",
          "transactionId",
          "storeSku",
          "quantity",
          "state",
          "token",
          "evidence"
        ],
        "additionalProperties": false
      },
      "StorePurchaseAccountBinding": {
        "type": "object",
        "properties": {
          "kind": {
            "oneOf": [
              {
                "const": "app-account-token"
              },
              {
                "const": "host-identity"
              },
              {
                "const": "obfuscated-account-id"
              }
            ],
            "readOnly": true
          },
          "value": {
            "type": "string",
            "readOnly": true
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      "StorePurchaseState": {
        "oneOf": [
          {
            "const": "pending"
          },
          {
            "const": "purchased"
          },
          {
            "const": "revoked"
          }
        ]
      }
    }
  }
}
