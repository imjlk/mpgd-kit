{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/imjlk/mpgd-kit/docs/specs/commerce/schemas/commerce-bridge-finish-transaction-payload.schema.json",
  "title": "CommerceBridgeFinishTransactionPayload",
  "x-mpgd-protocol": "mpgd.commerce.v2",
  "x-mpgd-protocol-version": "2.0.0-draft.1",
  "$ref": "#/components/schemas/FinishTransactionInput",
  "components": {
    "schemas": {
      "FinishTransactionInput": {
        "type": "object",
        "properties": {
          "transactionId": {
            "$ref": "#/components/schemas/NonEmptyString",
            "readOnly": true
          },
          "ledgerEntryId": {
            "$ref": "#/components/schemas/NonEmptyString",
            "readOnly": true
          },
          "isConsumable": {
            "type": "boolean",
            "readOnly": true
          },
          "retry": {
            "type": "boolean",
            "description": "The caller already asked to finish this purchase, in an earlier attempt\nor an earlier session (the reconciler sets it for a `client` finish of a\nrecord that was `finishing` before the call). A store may then read a\nconsumable missing from its unfinished list as one an earlier finish\ncompleted (a lost acknowledgement); a first finish never does. Absent\nmeans a first finish; a store without such a rule ignores it. Sent only to\na provider that declares `acceptsFinishRetry`.",
            "readOnly": true
          }
        },
        "required": [
          "transactionId",
          "ledgerEntryId",
          "isConsumable"
        ],
        "additionalProperties": false
      },
      "NonEmptyString": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
