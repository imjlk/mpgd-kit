{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/imjlk/mpgd-kit/docs/specs/notifications/schemas/notification-backend-bridge-register-endpoint-payload.schema.json",
  "title": "NotificationBackendBridgeRegisterEndpointPayload",
  "x-mpgd-protocol": "mpgd.notifications.v2",
  "x-mpgd-protocol-version": "2.0.0-draft.1",
  "$ref": "#/components/schemas/NotificationBackendBridgeRegisterEndpointPayload",
  "components": {
    "schemas": {
      "NonEmptyString": {
        "type": "string",
        "minLength": 1
      },
      "NotificationBackendBridgeRegisterEndpointPayload": {
        "type": "object",
        "properties": {
          "expectedPlayer": {
            "$ref": "#/components/schemas/NonEmptyString",
            "readOnly": true
          },
          "registration": {
            "$ref": "#/components/schemas/NotificationEndpointRegistration",
            "readOnly": true
          }
        },
        "required": [
          "expectedPlayer",
          "registration"
        ],
        "additionalProperties": false
      },
      "NotificationEndpointAddress": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "oneOf": [
                  {
                    "const": "fcm-installation"
                  },
                  {
                    "const": "fcm-token"
                  }
                ],
                "readOnly": true
              },
              "value": {
                "$ref": "#/components/schemas/NonEmptyString",
                "readOnly": true
              },
              "environment": {
                "oneOf": [
                  {
                    "const": "production"
                  },
                  {
                    "const": "sandbox"
                  }
                ],
                "readOnly": true
              },
              "permission": {
                "$ref": "#/components/schemas/NotificationPermissionState",
                "description": "The device's app-scope permission when this registration was sent.",
                "readOnly": true
              },
              "rendersAdvertising": {
                "type": "boolean",
                "description": "True when the app renders advertising pushes itself, with the\nadvertising opt-out action: an Android shell whose messaging service\nis the kit's renderer. An Android FCM notification message cannot\ncarry actions, so under the Korean rules the backend sends\nadvertising to an Android installation only when its latest\nregistration says so, as a data message the shell renders. Absent\nmeans false; the backend keeps it only for a target whose pushes\nneed it (`notificationShellRenderedAdvertisingTargets`).",
                "readOnly": true
              }
            },
            "required": [
              "kind",
              "value",
              "permission"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "platform-user",
                "readOnly": true
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        ]
      },
      "NotificationEndpointRegistration": {
        "type": "object",
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/NonEmptyString",
            "readOnly": true
          },
          "address": {
            "$ref": "#/components/schemas/NotificationEndpointAddress",
            "readOnly": true
          },
          "locale": {
            "$ref": "#/components/schemas/NonEmptyString",
            "readOnly": true
          },
          "timeZone": {
            "$ref": "#/components/schemas/NonEmptyString",
            "description": "IANA zone, used for a topic's quiet hours.",
            "readOnly": true
          }
        },
        "required": [
          "provider",
          "address"
        ],
        "additionalProperties": false,
        "description": "Where the server reaches this installation or player. The installation id\nis the authenticated session's, never a field of the registration."
      },
      "NotificationPermissionState": {
        "oneOf": [
          {
            "const": "action-required"
          },
          {
            "const": "blocked"
          },
          {
            "const": "denied"
          },
          {
            "const": "granted"
          },
          {
            "const": "prompt"
          },
          {
            "const": "prompt-with-rationale"
          },
          {
            "const": "unknown"
          },
          {
            "const": "unsupported"
          }
        ]
      }
    }
  }
}
