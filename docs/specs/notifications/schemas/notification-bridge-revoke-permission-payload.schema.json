{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/imjlk/mpgd-kit/docs/specs/notifications/schemas/notification-bridge-revoke-permission-payload.schema.json",
  "title": "NotificationBridgeRevokePermissionPayload",
  "x-mpgd-protocol": "mpgd.notifications.v2",
  "x-mpgd-protocol-version": "2.0.0-draft.1",
  "$ref": "#/components/schemas/NotificationBridgeRequestPermissionPayload",
  "components": {
    "schemas": {
      "NotificationBridgeRequestPermissionPayload": {
        "type": "object",
        "properties": {
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/NotificationTopicId"
            },
            "readOnly": true
          }
        },
        "required": [
          "topics"
        ],
        "additionalProperties": false
      },
      "NotificationTopicId": {
        "type": "string",
        "description": "Open topic id declared by the game's topic catalog."
      }
    }
  }
}
