{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/imjlk/mpgd-kit/docs/specs/notifications/schemas/notification-bridge-open-settings-result.schema.json",
  "title": "NotificationBridgeOpenSettingsResult",
  "x-mpgd-protocol": "mpgd.notifications.v2",
  "x-mpgd-protocol-version": "2.0.0-draft.1",
  "$ref": "#/components/schemas/NotificationBridgeOpenSettingsResult",
  "components": {
    "schemas": {
      "NotificationBridgeOpenSettingsResult": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/NotificationSettingsResult",
            "readOnly": true
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "NotificationSettingsResult": {
        "oneOf": [
          {
            "const": "opened"
          },
          {
            "const": "unavailable"
          }
        ]
      }
    }
  }
}
