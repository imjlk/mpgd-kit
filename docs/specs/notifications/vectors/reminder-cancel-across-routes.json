{
  "vector": "reminder-cancel-across-routes",
  "protocol": "2.0.0-draft.1",
  "summary": "A reminder key names one reminder across both routes: on a local-capable target a remote-only topic's reminder is stored on the server, and after a restart cancel still finds and removes it there.",
  "appliesTo": [
    {
      "path": "local.supported",
      "equals": true
    },
    {
      "path": "remote.supported",
      "equals": true
    }
  ],
  "profile": {
    "provider": "fixture.os-fcm",
    "capabilities": {
      "availability": "available",
      "permission": {
        "scope": "app",
        "prompt": "os",
        "readable": true,
        "serverReadable": false,
        "allowance": "persistent",
        "userGesture": false,
        "promptLimit": 2,
        "settings": true
      },
      "remote": {
        "supported": true,
        "purposes": [
          "service",
          "requested",
          "advertising"
        ],
        "addressing": "device",
        "content": "free-form"
      },
      "local": {
        "supported": true,
        "maxPending": 64
      },
      "open": "payload"
    }
  },
  "catalog": [
    {
      "id": "daily-puzzle",
      "purpose": "requested",
      "channels": [
        "remote"
      ],
      "route": "/?entry=daily",
      "copy": {
        "ko": {
          "title": "오늘의 퍼즐",
          "body": "새 퍼즐이 열렸어요."
        },
        "en": {
          "title": "Daily puzzle",
          "body": "A new puzzle is open."
        }
      },
      "mapping": {
        "channelId": "reminders"
      }
    }
  ],
  "context": {
    "player": "p-1",
    "now": "2026-10-12T03:00:00Z",
    "timeZone": "Asia/Seoul"
  },
  "steps": [
    {
      "actor": "runtime",
      "action": "start"
    },
    {
      "actor": "backend",
      "action": "authenticate",
      "player": "p-1"
    },
    {
      "actor": "host",
      "action": "issueEndpoint",
      "endpoint": {
        "kind": "fcm-token",
        "value": "tok-1"
      }
    },
    {
      "actor": "host",
      "action": "queuePrompt",
      "result": "granted"
    },
    {
      "actor": "game",
      "action": "requestPermission",
      "input": {
        "topics": [
          "daily-puzzle"
        ],
        "gesture": true
      }
    },
    {
      "actor": "game",
      "action": "setTopicPreference",
      "input": {
        "topic": "daily-puzzle",
        "enabled": true
      }
    },
    {
      "actor": "game",
      "action": "setReminder",
      "input": {
        "key": "daily",
        "topic": "daily-puzzle",
        "fireAt": "2026-10-12T06:00:00Z"
      },
      "returns": {
        "route": "remote",
        "status": "scheduled"
      }
    },
    {
      "actor": "runtime",
      "action": "restart"
    },
    {
      "actor": "game",
      "action": "cancelReminder",
      "input": {
        "key": "daily"
      },
      "returns": {
        "route": "remote",
        "status": "cancelled"
      }
    },
    {
      "actor": "game",
      "action": "cancelReminder",
      "input": {
        "key": "daily"
      },
      "returns": {
        "route": "none",
        "status": "cancelled"
      }
    }
  ],
  "expect": {
    "reminders": [],
    "local": {
      "operations": [],
      "pending": []
    }
  }
}
