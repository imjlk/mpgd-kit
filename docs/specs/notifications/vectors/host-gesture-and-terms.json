{
  "vector": "host-gesture-and-terms",
  "protocol": "2.0.0-draft.1",
  "summary": "A host that requires a user gesture refuses a request made without one before reaching the prompt; a host-terms refusal is blocked and is not prompted again.",
  "appliesTo": [
    {
      "path": "permission.prompt",
      "equals": "host"
    },
    {
      "path": "permission.userGesture",
      "equals": true
    }
  ],
  "profile": {
    "provider": "fixture.host-template",
    "capabilities": {
      "availability": "available",
      "permission": {
        "scope": "topic",
        "prompt": "host",
        "readable": false,
        "serverReadable": false,
        "allowance": "persistent",
        "userGesture": true,
        "settings": false
      },
      "remote": {
        "supported": true,
        "purposes": [
          "service",
          "requested"
        ],
        "addressing": "platform-user",
        "content": "host-template"
      },
      "local": {
        "supported": false,
        "timing": "none"
      },
      "open": "landing-url"
    }
  },
  "catalog": [
    {
      "id": "energy-full",
      "purpose": "requested",
      "channels": [
        "local",
        "remote"
      ],
      "route": "/?entry=continue",
      "copy": {
        "ko": {
          "title": "에너지 충전 완료",
          "body": "에너지가 가득 찼어요."
        },
        "en": {
          "title": "Energy full",
          "body": "Your energy is full."
        }
      },
      "mapping": {
        "templateSetCode": "fixture-energy-full"
      }
    }
  ],
  "context": {
    "player": "p-1",
    "now": "2026-10-12T03:00:00Z",
    "timeZone": "Asia/Seoul"
  },
  "steps": [
    {
      "actor": "runtime",
      "action": "start"
    },
    {
      "actor": "backend",
      "action": "authenticate",
      "player": "p-1"
    },
    {
      "actor": "game",
      "action": "requestPermission",
      "input": {
        "topics": [
          "energy-full"
        ],
        "gesture": false
      },
      "throws": {
        "code": "NOTIFICATIONS_USER_GESTURE_REQUIRED"
      }
    },
    {
      "actor": "host",
      "action": "queuePrompt",
      "result": "host-terms-declined"
    },
    {
      "actor": "game",
      "action": "requestPermission",
      "input": {
        "topics": [
          "energy-full"
        ],
        "gesture": true
      },
      "returns": {
        "outcomes": {
          "energy-full": "blocked"
        },
        "snapshot": {
          "topics": {
            "energy-full": "blocked"
          }
        }
      }
    },
    {
      "actor": "game",
      "action": "requestPermission",
      "input": {
        "topics": [
          "energy-full"
        ],
        "gesture": true
      },
      "returns": {
        "outcomes": {
          "energy-full": "blocked"
        }
      }
    }
  ],
  "expect": {
    "prompts": 1,
    "consent": [
      {
        "kind": "host-agreement",
        "topic": "energy-full",
        "state": "blocked",
        "source": "client-report"
      }
    ]
  }
}
