{
  "vector": "reminder-server-set-checks",
  "protocol": "2.0.0-draft.1",
  "summary": "A server reminder is checked against gate steps 3 to 5 when it is set: without a granted device it answers permission-required, without the player's request request-missing, after the player turns the topic off preference-off, and an advertising topic without consent advertising-consent-missing. A refusal stores nothing; the reminders that pass are stored.",
  "appliesTo": [
    {
      "path": "remote.supported",
      "equals": true
    },
    {
      "path": "remote.addressing",
      "equals": "device"
    },
    {
      "path": "remote.purposes",
      "includes": "advertising"
    }
  ],
  "profile": {
    "provider": "fixture.os-fcm",
    "capabilities": {
      "availability": "available",
      "permission": {
        "scope": "app",
        "prompt": "os",
        "readable": true,
        "serverReadable": false,
        "allowance": "persistent",
        "userGesture": false,
        "promptLimit": 2,
        "settings": true
      },
      "remote": {
        "supported": true,
        "purposes": [
          "service",
          "requested",
          "advertising"
        ],
        "addressing": "device",
        "content": "free-form"
      },
      "local": {
        "supported": true,
        "maxPending": 64
      },
      "open": "payload"
    }
  },
  "catalog": [
    {
      "id": "daily-puzzle",
      "purpose": "requested",
      "channels": [
        "remote"
      ],
      "route": "/?entry=daily",
      "copy": {
        "ko": {
          "title": "오늘의 퍼즐",
          "body": "새 퍼즐이 열렸어요."
        },
        "en": {
          "title": "Daily puzzle",
          "body": "A new puzzle is open."
        }
      },
      "mapping": {
        "channelId": "reminders"
      }
    },
    {
      "id": "weekend-event",
      "purpose": "advertising",
      "channels": [
        "remote"
      ],
      "route": "/events/weekend",
      "optOutRoute": "/settings/notifications",
      "copy": {
        "ko": {
          "title": "주말 이벤트",
          "body": "주말 이벤트가 시작됐어요."
        },
        "en": {
          "title": "Weekend event",
          "body": "The weekend event has started."
        }
      },
      "mapping": {
        "channelId": "advertising"
      }
    }
  ],
  "context": {
    "player": "p-1",
    "now": "2026-10-12T03:00:00Z",
    "timeZone": "Asia/Seoul"
  },
  "deployment": {
    "advertisingRules": "kr",
    "advertisingSender": {
      "contact": "080-1234-5678"
    }
  },
  "steps": [
    {
      "actor": "runtime",
      "action": "start"
    },
    {
      "actor": "backend",
      "action": "authenticate",
      "player": "p-1"
    },
    {
      "actor": "game",
      "action": "setReminder",
      "input": {
        "key": "daily",
        "topic": "daily-puzzle",
        "fireAt": "2026-10-13T00:00:00Z"
      },
      "returns": {
        "route": "remote",
        "status": "permission-required"
      }
    },
    {
      "actor": "host",
      "action": "issueEndpoint",
      "endpoint": {
        "kind": "fcm-token",
        "value": "tok-1"
      }
    },
    {
      "actor": "host",
      "action": "queuePrompt",
      "result": "granted"
    },
    {
      "actor": "game",
      "action": "requestPermission",
      "input": {
        "topics": [
          "daily-puzzle",
          "weekend-event"
        ],
        "gesture": true
      }
    },
    {
      "actor": "game",
      "action": "setReminder",
      "input": {
        "key": "daily",
        "topic": "daily-puzzle",
        "fireAt": "2026-10-13T00:00:00Z"
      },
      "returns": {
        "route": "remote",
        "status": "request-missing"
      }
    },
    {
      "actor": "game",
      "action": "setTopicPreference",
      "input": {
        "topic": "daily-puzzle",
        "enabled": true
      }
    },
    {
      "actor": "game",
      "action": "setReminder",
      "input": {
        "key": "daily",
        "topic": "daily-puzzle",
        "fireAt": "2026-10-13T00:00:00Z"
      },
      "returns": {
        "route": "remote",
        "status": "scheduled"
      }
    },
    {
      "actor": "game",
      "action": "setTopicPreference",
      "input": {
        "topic": "daily-puzzle",
        "enabled": false
      }
    },
    {
      "actor": "game",
      "action": "setReminder",
      "input": {
        "key": "daily-2",
        "topic": "daily-puzzle",
        "fireAt": "2026-10-14T00:00:00Z"
      },
      "returns": {
        "route": "remote",
        "status": "preference-off"
      }
    },
    {
      "actor": "game",
      "action": "setReminder",
      "input": {
        "key": "weekend",
        "topic": "weekend-event",
        "fireAt": "2026-10-13T01:00:00Z"
      },
      "returns": {
        "route": "remote",
        "status": "advertising-consent-missing"
      }
    },
    {
      "actor": "game",
      "action": "setAdvertisingConsent",
      "input": {
        "advertising": "granted",
        "textVersion": "ad-consent-v1"
      }
    },
    {
      "actor": "game",
      "action": "setReminder",
      "input": {
        "key": "weekend",
        "topic": "weekend-event",
        "fireAt": "2026-10-13T01:00:00Z"
      },
      "returns": {
        "route": "remote",
        "status": "scheduled"
      }
    }
  ],
  "expect": {
    "reminders": [
      {
        "player": "p-1",
        "key": "daily",
        "topic": "daily-puzzle",
        "fireAt": "2026-10-13T00:00:00Z"
      },
      {
        "player": "p-1",
        "key": "weekend",
        "topic": "weekend-event",
        "fireAt": "2026-10-13T01:00:00Z"
      }
    ],
    "providerCalls": [],
    "local": {
      "operations": [],
      "pending": []
    }
  }
}
