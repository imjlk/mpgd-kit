{
  "vector": "endpoint-rotation",
  "protocol": "2.0.0-draft.1",
  "summary": "A device address rotated after registration reaches the backend through the endpoint-changed event without an explicit register call, and replaces the old address for that installation.",
  "appliesTo": [
    {
      "path": "remote.addressing",
      "equals": "device"
    }
  ],
  "profile": {
    "provider": "fixture.os-fcm",
    "capabilities": {
      "availability": "available",
      "permission": {
        "scope": "app",
        "prompt": "os",
        "readable": true,
        "serverReadable": false,
        "allowance": "persistent",
        "userGesture": false,
        "promptLimit": 2,
        "settings": true
      },
      "remote": {
        "supported": true,
        "purposes": [
          "service",
          "requested",
          "advertising"
        ],
        "addressing": "device",
        "content": "free-form"
      },
      "local": {
        "supported": true,
        "maxPending": 64,
        "timing": "inexact"
      },
      "open": "payload"
    }
  },
  "catalog": [
    {
      "id": "friend-challenge",
      "purpose": "service",
      "channels": [
        "remote"
      ],
      "route": "/?entry=friend-challenge",
      "copy": {
        "ko": {
          "title": "새 도전장",
          "body": "{{friend}}님이 도전장을 보냈어요."
        },
        "en": {
          "title": "New challenge",
          "body": "{{friend}} sent you a challenge."
        }
      },
      "mapping": {
        "channelId": "reminders"
      }
    }
  ],
  "context": {
    "player": "p-1",
    "now": "2026-10-12T03:00:00Z",
    "timeZone": "Asia/Seoul"
  },
  "steps": [
    {
      "actor": "runtime",
      "action": "start"
    },
    {
      "actor": "backend",
      "action": "authenticate",
      "player": "p-1"
    },
    {
      "actor": "host",
      "action": "issueEndpoint",
      "endpoint": {
        "kind": "fcm-token",
        "value": "tok-1"
      }
    },
    {
      "actor": "host",
      "action": "queuePrompt",
      "result": "granted"
    },
    {
      "actor": "game",
      "action": "requestPermission",
      "input": {
        "topics": [
          "friend-challenge"
        ],
        "gesture": true
      }
    },
    {
      "actor": "host",
      "action": "issueEndpoint",
      "endpoint": {
        "kind": "fcm-token",
        "value": "tok-2"
      }
    },
    {
      "actor": "backend",
      "action": "deliver",
      "input": {
        "topic": "friend-challenge",
        "idempotencyKey": "x-1",
        "templateData": {
          "friend": "Mina"
        },
        "locale": "en"
      },
      "returns": {
        "status": "delivered"
      }
    }
  ],
  "expect": {
    "endpoints": [
      {
        "provider": "fixture.os-fcm",
        "kind": "fcm-token",
        "value": "tok-2",
        "installationId": "installation-1",
        "player": "p-1",
        "status": "valid"
      }
    ],
    "providerCalls": [
      {
        "topic": "friend-challenge",
        "address": "tok-2"
      }
    ]
  }
}
