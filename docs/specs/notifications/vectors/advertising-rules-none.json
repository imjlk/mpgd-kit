{
  "vector": "advertising-rules-none",
  "protocol": "2.0.0-draft.1",
  "summary": "A deployment without the Korean rules still needs advertising consent but applies no night window, label, sender line, or expiry.",
  "appliesTo": [
    {
      "path": "remote.purposes",
      "includes": "advertising"
    },
    {
      "path": "remote.addressing",
      "equals": "device"
    }
  ],
  "profile": {
    "provider": "fixture.os-fcm",
    "capabilities": {
      "availability": "available",
      "permission": {
        "scope": "app",
        "prompt": "os",
        "readable": true,
        "serverReadable": false,
        "allowance": "persistent",
        "userGesture": false,
        "promptLimit": 2,
        "settings": true
      },
      "remote": {
        "supported": true,
        "purposes": [
          "service",
          "requested",
          "advertising"
        ],
        "addressing": "device",
        "content": "free-form"
      },
      "local": {
        "supported": true,
        "maxPending": 64
      },
      "open": "payload"
    }
  },
  "catalog": [
    {
      "id": "weekend-event",
      "purpose": "advertising",
      "channels": [
        "remote"
      ],
      "route": "/events/weekend",
      "optOutRoute": "/settings/notifications",
      "copy": {
        "ko": {
          "title": "주말 이벤트",
          "body": "주말 이벤트가 시작됐어요."
        },
        "en": {
          "title": "Weekend event",
          "body": "The weekend event has started."
        }
      },
      "mapping": {
        "channelId": "advertising"
      }
    }
  ],
  "context": {
    "player": "p-1",
    "now": "2026-10-12T13:00:00Z",
    "timeZone": "Asia/Seoul"
  },
  "deployment": {
    "advertisingRules": "none"
  },
  "steps": [
    {
      "actor": "runtime",
      "action": "start"
    },
    {
      "actor": "backend",
      "action": "authenticate",
      "player": "p-1"
    },
    {
      "actor": "host",
      "action": "issueEndpoint",
      "endpoint": {
        "kind": "fcm-token",
        "value": "tok-1"
      }
    },
    {
      "actor": "host",
      "action": "queuePrompt",
      "result": "granted"
    },
    {
      "actor": "game",
      "action": "requestPermission",
      "input": {
        "topics": [
          "weekend-event"
        ],
        "gesture": true
      }
    },
    {
      "actor": "game",
      "action": "setAdvertisingConsent",
      "input": {
        "advertising": "granted",
        "textVersion": "ad-consent-v1"
      }
    },
    {
      "actor": "backend",
      "action": "deliver",
      "input": {
        "topic": "weekend-event",
        "idempotencyKey": "o-1",
        "locale": "ko"
      },
      "returns": {
        "status": "delivered"
      }
    }
  ],
  "expect": {
    "deliveries": [
      {
        "idempotencyKey": "o-1",
        "status": "delivered"
      }
    ],
    "providerCalls": [
      {
        "topic": "weekend-event",
        "content": {
          "title": "주말 이벤트",
          "body": "주말 이벤트가 시작됐어요."
        },
        "expiresAt": null
      }
    ],
    "notices": []
  }
}
