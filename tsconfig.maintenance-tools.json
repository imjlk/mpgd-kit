{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "tools/validate-share-link-conformance*.ts",
    "tools/docs/verify-evidence-entrypoints.ts",
    "lint.source.config.ts",
    "lint.config.ts",
    "strip.config.js",
    "tools/fixtures/typed-config-canary.ts",
    "tools/policy/**/*.ts",
    "tools/graph/*.ts",
    "tools/validate-capacitor-*.ts",
    "tools/validation/**/*.ts",
    "tools/graph-runtime.test.ts",
    "tools/workspace/kit-dependency-links.mjs",
    "tools/workspace/relink-kit-workspace.mjs"
  ]
}
