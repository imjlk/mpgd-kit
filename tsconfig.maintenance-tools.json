{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "tools/validate-share-link-conformance*.ts",
    "tools/docs/verify-evidence-entrypoints.ts",
    "tools/config/lint.ts",
    "lint.config.ts",
    "strip.config.js",
    "tools/fixtures/typed-config-canary.ts"
  ]
}
