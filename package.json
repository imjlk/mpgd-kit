{
  "name": "mpgd-kit",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-Platform Game Distribution / Development kit for Phaser games.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjlk/mpgd-kit.git"
  },
  "bugs": {
    "url": "https://github.com/imjlk/mpgd-kit/issues"
  },
  "homepage": "https://github.com/imjlk/mpgd-kit#readme",
  "keywords": [
    "mpgd",
    "phaser",
    "vite",
    "typescript",
    "capacitor",
    "apps-in-toss",
    "game-development",
    "game-distribution"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "i18n:build": "pnpm --dir packages/i18n paraglide:build",
    "check": "pnpm validate:toolchain && pnpm validate:capacitor-alignment && pnpm validate:capacitor-fail-closed && pnpm i18n:build && pnpm validate:public && ttsc --noEmit -p tsconfig.tools.json && pnpm validate:starter-workflow && pnpm -r --if-present check",
    "dev:game": "pnpm --dir examples/phaser-starter dev",
    "dev:tutorial": "pnpm --dir examples/tutorial-driver dev",
    "build:tutorial": "pnpm --dir examples/tutorial-driver build",
    "lint": "pnpm -r --if-present lint",
    "format": "ttsc format -p tsconfig.format.json",
    "fix": "pnpm -r --if-present fix",
    "test": "pnpm build:packages && pnpm test:prepared",
    "test:prepared": "node tools/ci/prepared-suite.mjs all",
    "test:prepared:contracts": "node tools/ci/prepared-suite.mjs contracts --checked",
    "test:prepared:cli": "node tools/ci/prepared-suite.mjs cli --checked",
    "test:prepared:services": "node tools/ci/prepared-suite.mjs services --checked",
    "ci:emit-tools:prepared": "ttsc -p tsconfig.ci-tools.json",
    "test:cli-output": "node tools/smoke/cli-output.mjs",
    "test:tooling": "node --test tools/toolchain.test.mjs tools/graph-runtime.test.mjs tools/ci/prepared-suite.test.mjs tools/ci/native-scope.test.mjs tools/ci/verify-coverage.test.mjs",
    "validate:toolchain": "node tools/validate-toolchain.mjs",
    "validate:capacitor-alignment": "node tools/validate-capacitor-alignment.mjs",
    "validate:capacitor-fail-closed": "node tools/validate-capacitor-fail-closed.mjs",
    "cache:paths": "node node_modules/ttsc/lib/launcher/ttsc.js cache paths --json",
    "docs:evidence": "node tools/docs/verify-evidence-entrypoints.mjs && MPGD_EVIDENCE=1 ttsc --noEmit -p tsconfig.evidence.json",
    "docs:examples:check": "ttsc --noEmit -p tsconfig.docs-examples.json",
    "docs:examples:test": "vitest run --config docs/examples/vitest.config.ts",
    "docs:site:build": "rspress build",
    "docs:site:dev": "rspress dev",
    "docs:site:preview": "rspress preview",
    "test:ttsx-assertions": "node tools/smoke/ttsx-assertions.mjs",
    "test:icons": "node tools/run-ttsx.mjs tools/icons/icons.test.ts",
    "test:native-ios-signing": "node tools/run-ttsx.mjs tools/target/native-ios-signing.test.ts",
    "test:target-artifacts": "node tools/run-ttsx.mjs tools/target/platform-targets.test.ts && node tools/run-ttsx.mjs tools/target/minigame-package-budget.test.ts && node tools/run-ttsx.mjs tools/target/minigame-project-files.test.ts && node tools/run-ttsx.mjs tools/target/minigame-artifact.test.ts && node tools/run-ttsx.mjs --project examples/phaser-starter/tsconfig.minigame-bridge-test.json examples/phaser-starter/src/platform/minigameBridgeLifecycle.test.ts && node tools/run-ttsx.mjs --project examples/phaser-starter/tsconfig.text-selection-test.json examples/phaser-starter/src/platform/textSelection.test.ts && node tools/run-ttsx.mjs --project examples/phaser-starter/tsconfig.minigame-output-test.json examples/phaser-starter/vite.minigame-output.test.ts && MPGD_PLATFORM_TARGETS_FILE=examples/phaser-starter/mpgd.targets.json node tools/run-ttsx.mjs tools/smoke/verify-target-artifacts.test.ts && node tools/run-ttsx.mjs tools/target/web-artifact.test.ts && node tools/run-ttsx.mjs tools/target/native-build-contracts.test.ts",
    "test:workspaces": "pnpm -r --if-present test",
    "test:workspaces:prepared": "pnpm -r --workspace-concurrency=1 --filter @mpgd/i18n --filter @mpgd/game-runtime --filter @mpgd/phaser-minigame-runtime --filter @mpgd/adapter-wechat --if-present test && pnpm -r --filter '!@mpgd/app-game-services-worker' --filter '!@mpgd/i18n' --filter '!@mpgd/game-runtime' --filter '!@mpgd/phaser-minigame-runtime' --filter '!@mpgd/adapter-wechat' --filter '!{.}' --if-present test",
    "validate:catalog": "node tools/run-ttsx.mjs tools/validate-product-catalog.ts",
    "validate:ads": "node tools/run-ttsx.mjs tools/validate-ad-placements.ts",
    "validate:i18n": "pnpm --dir packages/i18n test",
    "validate:target-config": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/validate-target-config.ts",
    "validate:effective-config": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/validate-effective-target-config.ts",
    "validate:targets": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/target/validate-platform-targets.ts",
    "validate:public": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/validate-public-readiness.ts",
    "validate:starter-workflow": "node tools/run-ttsx.mjs tools/validate-starter-workflow.ts",
    "mpgd": "node tools/run-ttsx.mjs --mpgd-cli packages/cli/src/bin.ts",
    "create:game": "node tools/run-ttsx.mjs --mpgd-cli packages/cli/src/bin.ts game create",
    "build:target": "pnpm i18n:build && MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/target/build-target.ts",
    "build:web": "pnpm build:target web-preview production",
    "build:microsoft-store": "pnpm build:target microsoft-store production",
    "build:verse8": "pnpm build:target verse8 production",
    "build:android": "pnpm build:target android production",
    "build:ios": "pnpm build:target ios production",
    "build:ait": "pnpm build:target ait production",
    "build:devvit": "pnpm build:target reddit production",
    "build:wechat": "pnpm build:target wechat staging",
    "build:effective-config": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/target/generate-effective-target-config.ts",
    "preview:platform-versions": "node tools/run-ttsx.mjs tools/target/preview-platform-versions.ts",
    "game:icons:generate": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/icons/run.ts generate",
    "game:icons:verify": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/icons/run.ts verify",
    "game:icons:inspect": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/icons/run.ts inspect",
    "build:packages": "pnpm i18n:build && node tools/run-ttsx.mjs tools/package/build-packages.ts",
    "pack:packages": "pnpm build:packages && pnpm pack:packages:prepared",
    "pack:packages:prepared": "node tools/run-ttsx.mjs tools/package/pack-packages.ts && pnpm smoke:tutorial:package",
    "smoke:target": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/smoke/verify-target-artifacts.ts",
    "smoke:wechat": "pnpm smoke:target wechat",
    "smoke:wechat:devtool": "node tools/run-ttsx.mjs tools/smoke/wechat-devtool.ts",
    "smoke:targets": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/smoke/verify-target-artifacts.ts",
    "smoke:i18n": "pnpm --dir packages/i18n test",
    "smoke:target-config": "node tools/run-ttsx.mjs tools/smoke/target-config-runtime.ts",
    "smoke:target-config-extensions": "node tools/run-ttsx.mjs tools/smoke/target-config-extensions.ts",
    "smoke:target-config:dist": "node packages/target-config/test/dist-import.mjs",
    "smoke:tutorial:dist": "node packages/tutorial/test/dist-import.mjs",
    "smoke:tutorial:package": "node packages/tutorial/test/package-import.mjs",
    "smoke:effective-config": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/smoke/effective-target-config.ts",
    "smoke:microsoft-store-pwa-release": "node tools/run-ttsx.mjs tools/smoke/microsoft-store-pwa-release.ts",
    "smoke:platform-version-allocation": "node tools/run-ttsx.mjs tools/smoke/cli-platform-version-allocation.ts",
    "smoke:game-config": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/smoke/game-owned-catalog.ts",
    "smoke:cli-hosted-pwa-deployment": "node tools/run-ttsx.mjs tools/smoke/cli-hosted-pwa-deployment.ts",
    "smoke:cli-kit-upgrade": "node tools/run-ttsx.mjs tools/smoke/cli-kit-upgrade.ts",
    "smoke:cli-asset-pack-build": "node tools/run-ttsx.mjs tools/smoke/cli-asset-pack-build.ts",
    "smoke:phaser-assets-archive-decode": "node tools/run-ttsx.mjs tools/smoke/phaser-assets-archive-decode.ts",
    "smoke:cli-configured-web-targets": "node tools/run-ttsx.mjs tools/smoke/cli-configured-web-targets.ts",
    "smoke:cli-game-release-inputs": "node tools/run-ttsx.mjs tools/smoke/cli-game-release-inputs.ts",
    "smoke:cli-game-acceptance": "node tools/run-ttsx.mjs tools/smoke/cli-game-acceptance.ts",
    "smoke:cli-gameplay-e2e": "node tools/run-ttsx.mjs tools/smoke/cli-gameplay-e2e.ts",
    "smoke:cli-browser-gameplay-e2e": "node tools/run-ttsx.mjs tools/smoke/cli-browser-gameplay-e2e.ts",
    "smoke:cli-offline-playtest": "node tools/run-ttsx.mjs tools/smoke/cli-offline-playtest.ts",
    "smoke:cli-microsoft-store-pwa-e2e": "node tools/run-ttsx.mjs tools/smoke/cli-microsoft-store-pwa-e2e.ts",
    "smoke:cli-microsoft-store-submission": "node tools/run-ttsx.mjs tools/smoke/cli-microsoft-store-submission.ts",
    "smoke:cli-microsoft-store-package-generation": "node tools/run-ttsx.mjs tools/smoke/cli-microsoft-store-package-generation.ts",
    "smoke:cli-microsoft-store-package-acceptance": "node tools/run-ttsx.mjs tools/smoke/cli-microsoft-store-package-acceptance.ts",
    "smoke:cli-microsoft-store-starter-onboarding": "node tools/run-ttsx.mjs tools/smoke/cli-microsoft-store-starter-onboarding.ts",
    "smoke:cli-capacitor-shell-starter": "node tools/run-ttsx.mjs packages/cli/test/capacitor-shell-starter.test.ts",
    "smoke:cli-deploy-planning": "node tools/run-ttsx.mjs packages/cli/src/deploy-planning.test.ts",
    "smoke:cli-deploy-process": "node tools/run-ttsx.mjs packages/cli/src/deploy-process.test.ts",
    "smoke:cli-release-workspace": "node tools/run-ttsx.mjs packages/cli/src/release-workspace.test.ts",
    "smoke:cli-capacitor-shell-materialize": "node tools/run-ttsx.mjs tools/smoke/cli-capacitor-shell-materialize.ts",
    "smoke:native-packed-consumer": "node tools/smoke/native-packed-consumer.mjs",
    "smoke:native-cli-packed-consumer": "node tools/smoke/native-cli-packed-consumer.mjs",
    "smoke:native-cli-packed-sync-ios": "node tools/smoke/native-cli-packed-consumer.mjs --sync-ios",
    "smoke:native-packed-swift": "node tools/smoke/native-packed-swift.mjs",
    "smoke:production-target-readiness": "node tools/run-ttsx.mjs tools/smoke/production-target-readiness.ts",
    "smoke:native-release-identity": "node tools/run-ttsx.mjs tools/target/native-release-identity.test.ts",
    "smoke:release-manifest-merge": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/smoke/release-manifest-merge.ts",
    "smoke:adapter-effective-config": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/smoke/adapter-effective-config.ts",
    "smoke:platform-capability-conformance": "node tools/run-ttsx.mjs tools/smoke/platform-capability-conformance.ts",
    "smoke:storage-adapter-conformance": "node tools/run-ttsx.mjs tools/smoke/storage-adapter-conformance.ts",
    "smoke:verse8-agent8-acceptance": "node tools/run-ttsx.mjs tools/smoke/verse8-agent8-acceptance.ts",
    "smoke:admob-ssv-conformance": "node tools/run-ttsx.mjs tools/smoke/admob-ssv-conformance.ts",
    "smoke:google-play-purchase": "node tools/run-ttsx.mjs packages/game-services/src/google-play-purchase.test.ts",
    "smoke:app-store-purchase": "node tools/run-ttsx.mjs packages/game-services/src/app-store-verifier.test.ts",
    "smoke:apps-in-toss-production-evidence": "pnpm build:packages && pnpm smoke:apps-in-toss-production-evidence:prepared",
    "smoke:apps-in-toss-production-evidence:prepared": "node tools/run-ttsx.mjs tools/smoke/apps-in-toss-production-evidence.ts",
    "smoke:game-services": "pnpm build:packages && pnpm smoke:game-services:prepared",
    "smoke:game-services:prepared": "node tools/run-ttsx.mjs tools/smoke/game-services-vertical-slice.ts",
    "smoke:game-services:worker": "pnpm build:packages && pnpm smoke:game-services:worker:prepared",
    "smoke:game-services:worker:prepared": "pnpm --dir apps/game-services-worker check && pnpm --dir apps/game-services-worker build && pnpm --dir apps/game-services-worker test",
    "smoke:game-services:worker:checked": "pnpm --dir apps/game-services-worker build && pnpm --dir apps/game-services-worker test",
    "smoke:targets:build": "MPGD_PLATFORM_TARGETS_FILE=${MPGD_PLATFORM_TARGETS_FILE:-examples/phaser-starter/mpgd.targets.json} node tools/run-ttsx.mjs tools/smoke/build-target-artifacts.ts",
    "smoke:android:emulator": "node tools/run-ttsx.mjs tools/smoke/android-emulator.ts",
    "smoke:ios:simulator": "node tools/run-ttsx.mjs tools/smoke/ios-simulator.ts",
    "release:target": "node tools/run-ttsx.mjs tools/target/release-target.ts",
    "manifest:release": "node tools/run-ttsx.mjs tools/target/generate-release-manifest.ts",
    "graph:dump": "node tools/graph/inspect-local-graph.mjs --dump",
    "graph:inspect": "node tools/graph/inspect-local-graph.mjs",
    "graph:target": "node tools/graph/inspect-local-graph.mjs --preset target-release",
    "graph:package": "node tools/graph/inspect-local-graph.mjs --preset package-publish",
    "graph:bridge": "node tools/graph/inspect-local-graph.mjs --preset bridge-contracts",
    "graph:starter": "node tools/graph/inspect-local-graph.mjs --preset starter-loop",
    "graph:game-services": "node tools/graph/run-graph-presets.mjs game-services-contract game-services-backend",
    "graph:target-config": "node tools/graph/inspect-local-graph.mjs --preset target-config-runtime",
    "graph:tutorial": "node tools/graph/run-graph-presets.mjs tutorial-core tutorial-driver",
    "graph:preflight": "node tools/graph/run-graph-presets.mjs",
    "sampo:add": "sampo add",
    "sampo:release:dry-run": "sampo release --dry-run",
    "sampo:release": "sampo release",
    "sampo:publish": "sampo publish",
    "sampo:pre": "sampo pre",
    "smoke:game-services:dist": "node packages/game-services/test/operation-progress-import.mjs && ttsc --noEmit -p packages/game-services/test/operation-progress-types.json && ttsc --noEmit -p packages/game-services/test/operations-headless-types.json",
    "smoke:cli-asset-pack-verify": "node tools/run-ttsx.mjs tools/smoke/cli-asset-pack-verify.ts"
  },
  "devDependencies": {
    "@mpgd/adapter-devvit": "workspace:*",
    "@mpgd/adapter-verse8": "workspace:*",
    "@mpgd/analytics": "workspace:*",
    "@mpgd/bridge": "workspace:*",
    "@mpgd/catalog": "workspace:*",
    "@mpgd/game-services": "workspace:*",
    "@mpgd/i18n": "workspace:*",
    "@mpgd/platform": "workspace:*",
    "@mpgd/release-manifest": "workspace:*",
    "@mpgd/target-config": "workspace:*",
    "@rspress/core": "2.0.22",
    "@ttsc/evidence": "0.30.4",
    "@ttsc/graph": "0.30.4",
    "@ttsc/lint": "0.30.4",
    "@ttsc/paths": "0.30.4",
    "@ttsc/strip": "0.30.4",
    "@ttsc/unplugin": "0.30.4",
    "@types/node": "^24.0.0",
    "acorn": "8.17.0",
    "esbuild": "0.28.1",
    "sharp": "^0.35.3",
    "ttsc": "0.30.4",
    "typescript": "7.0.2",
